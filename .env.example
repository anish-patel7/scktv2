# WeaveOne ERP — Environment Variables

# Supabase Cloud Connection (Get these from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Server Port (Default: 3000)
PORT=3000

# WhatsApp Business API (Optional for Production Webhook)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=weaveone_whatsapp_verify_token_2026
